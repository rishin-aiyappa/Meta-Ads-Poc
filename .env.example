# Copy to .env and fill in. Never commit the filled-in .env.
#
# Nothing in this package hardcodes a secret. With nothing set, the scripts
# REFUSE to run and name what is missing -- there is deliberately no mock mode,
# so a run started by mistake can never produce invented rows.
#
# There is exactly ONE secret below: META_ACCESS_TOKEN. Everything else is a
# non-secret identifier or a tuning knob.

# --- the only secret ------------------------------------------------------
# The shared System User token minted in Skypoint's Business Manager, with the
# ads_read permission. There is ONE of these for the whole platform, not one
# per client. It is static: it does not expire and there is no refresh flow.
# Put it here only -- never into a chat, a ticket, or a commit.
META_ACCESS_TOKEN=

# --- per-client scoping input (NOT a credential) --------------------------
# The client's ad account. This is what decides whose data comes back, and in
# Studio it is a plain form field (isCredential: false). With or without the
# act_ prefix; both are accepted.
# Leave blank until a client has approved Partner access and the account has
# been assigned to the System User and connected to the app.
META_AD_ACCOUNT_ID=

# --- non-secret identifiers -----------------------------------------------
# Skypoint Cloud Inc. Business Portfolio. Optional.
META_BUSINESS_ID=1764780201388148

# Skypoint Ads Integration app. Optional: used only to sanity-check that the
# token really was minted against the app we think it was.
META_APP_ID=1728017481639772

# --- tuning ---------------------------------------------------------------
# Graph API version. Confirm against Meta's current release before the real
# build -- versions are deprecated roughly two years after release.
META_API_VERSION=v23.0

# Hard ceiling on requests/second, shared across every call in the process.
META_RPS=5
